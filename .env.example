# Copy this to .env and fill in the values you have. Never commit .env.
# Everything here is optional: without credentials the harness runs in stub
# mode (realistic sample data, no API calls) and the stub LLM drafts.

# LLM (any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, ...).
# Without HARNESS_LLM_API_KEY the stub LLM is used.
HARNESS_LLM_BASE_URL=https://api.openai.com/v1
HARNESS_LLM_API_KEY=
HARNESS_LLM_MODEL=gpt-4o-mini
HARNESS_ROUTER_MODEL=gpt-4o-mini

# Force stub mode for all connectors, even if credentials are present.
HARNESS_STUB=

# Salesforce (REST API, SOQL). Leave blank for stub mode.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Slack (Web API). Leave blank for stub mode.
SLACK_BOT_TOKEN=

# Gong (REST API v2). Leave blank for stub mode.
GONG_ACCESS_TOKEN=
GONG_API_BASE_URL=https://api.gong.io/v2

# HubSpot (CRM API, private app token). Leave blank for stub mode.
HUBSPOT_ACCESS_TOKEN=
# Portal (hub) id, for deep links to records. Optional: without it the
# harness still gathers, but builds no HubSpot links. Falls back to the
# account-info API when unset.
HUBSPOT_PORTAL_ID=

# Gmail (Gmail API, OAuth 2.0 refresh-token flow). Leave blank for stub mode.
# Client id + secret come from an OAuth client (Desktop app type) in Google
# Cloud Console with the Gmail API enabled. The refresh token is minted
# once with the readonly scope
# https://www.googleapis.com/auth/gmail.readonly (OAuth 2.0 Playground or
# a one-off google-auth-oauthlib installed-app flow). Read-only by scope:
# the connector can never send or delete mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Zoom (API, server-to-server OAuth). Leave blank for stub mode.
# The Zoom app needs the recording:read:admin scope. The connector
# exchanges the triple for an access token (grant_type=account_credentials).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zendesk (API, token auth). Leave blank for stub mode.
# Auth is HTTP Basic with username "{email}/token" and password the API
# token (Admin Center > Apps and integrations > APIs > Zendesk API).
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Linear (GraphQL API, API key). Leave blank for stub mode.
# Auth is the raw API key in the Authorization header (Settings > API >
# Personal API keys).
LINEAR_API_KEY=

# Champify (API, API key). Leave blank for stub mode.
# Auth is the raw API key as a Bearer token. Note: Champify publishes no
# public API reference, so the live endpoint shapes are assumed from the
# product's data model; correct them against the real API the first time
# a key is available.
CHAMPIFY_API_KEY=
CHAMPIFY_API_BASE_URL=https://api.champify.io/v1

# Approval queue file and per-job token budget.
HARNESS_APPROVALS_FILE=approvals.json
HARNESS_TOKEN_BUDGET=8000

# Loaded hourly rate in dollars, used by value-finder to turn hours saved
# into dollars (hours saved x loaded rate). Never assumed: without it
# (and without --hourly-rate on the run) time saved is reported in
# hours only, not dollars.
HARNESS_LOADED_HOURLY_RATE=
