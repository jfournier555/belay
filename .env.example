# Copy this to .env and fill in the values you have. Never commit .env.
# Everything here is optional: without credentials the harness runs in stub
# mode (realistic sample data, no API calls) and the stub LLM drafts.

# LLM (any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, ...).
# Without HARNESS_LLM_API_KEY the stub LLM is used.
HARNESS_LLM_BASE_URL=https://api.openai.com/v1
HARNESS_LLM_API_KEY=
HARNESS_LLM_MODEL=gpt-4o-mini
HARNESS_ROUTER_MODEL=gpt-4o-mini

# Force stub mode for all connectors, even if credentials are present.
HARNESS_STUB=

# Salesforce (REST API, SOQL). Leave blank for stub mode.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Slack (Web API). Leave blank for stub mode.
SLACK_BOT_TOKEN=

# Gong (REST API v2). Leave blank for stub mode.
GONG_ACCESS_TOKEN=
GONG_API_BASE_URL=https://api.gong.io/v2

# HubSpot (CRM API, private app token). Leave blank for stub mode.
HUBSPOT_ACCESS_TOKEN=
# Portal (hub) id, for deep links to records. Optional: without it the
# harness still gathers, but builds no HubSpot links. Falls back to the
# account-info API when unset.
HUBSPOT_PORTAL_ID=

# Approval queue file and per-job token budget.
HARNESS_APPROVALS_FILE=approvals.json
HARNESS_TOKEN_BUDGET=8000
